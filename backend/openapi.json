            }
          },
          {
            "description": "分类 slug，可重复传",
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "分类 slug，可重复传",
              "title": "Category"
            }
          },
          {
            "description": "标签名，可重复传",
            "in": "query",
            "name": "tag",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "标签名，可重复传",
              "title": "Tag"
            }
          },
          {
            "description": "file/webapp/skill/prompt，可重复传",
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "file/webapp/skill/prompt，可重复传",
              "title": "Type"
            }
          },
          {
            "description": "按作者 username 筛选",
            "in": "query",
            "name": "owner",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "按作者 username 筛选",
              "title": "Owner"
            }
          },
          {
            "description": "hot（默认）/ new / name / -updated_at",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
