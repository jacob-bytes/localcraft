  "info": {
    "description": "selftool — 内网工具 / Skill 共享平台后端",
    "title": "selftool API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/change-password": {
      "post": {
        "description": "校验旧密码 → 强度校验 → 更新哈希 → 清 `must_change_password`\n→ 吊销该用户**全部其他 session**（FR-AUTH-10 / 契约 §3.2 ⑥）。\n\n同时清掉当前 refresh Cookie：契约 §3.2 ⑥ 要求「改密成功后强制用新密码\n重新登录」，而登录页挂载时会尝试 refresh。若 Cookie 还在，refresh 会成功\n并把用户静默弹回门户，与契约 §8 验收第 11 条冲突。",
        "operationId": "change_password_api_v1_auth_change_password_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Change Password Api V1 Auth Change Password Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "修改自己的密码",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "登录成功 → 返回 access token + `user`，并 `Set-Cookie` 下发 refresh token。\n\n失败：\n  - 用户名或密码错误 → 401 `INVALID_CREDENTIALS`（**同一个码、同一句文案**）\n  - 账号禁用 → 403 `ACCOUNT_DISABLED`\n  - 账号锁定 → 423 `ACCOUNT_LOCKED`（`details.retry_after_seconds`）",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "登录",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "吊销该 session 行并清 Cookie（FR-AUTH-07）。\n\n幂等，且**不要求 Bearer 头** —— access token 过期后用户仍应能可靠登出。",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Logout Api V1 Auth Logout Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
