# ============================================================
# localcraft 环境变量样例（开发机 / 仓库布局）
# ------------------------------------------------------------
# 复制为 backend/.env 后按需修改：
#     cp backend/.env.example backend/.env
# 生产环境请用 deploy/localcraft.env.example → /etc/localcraft/localcraft.env
#
# 注意（docs/01 FR-CFG-05）：SECRET_KEY 与数据库连接串**只走环境变量**，
# 绝不进系统设置表、不进数据库。
# ============================================================

# ---------- 基础运行参数 ----------
LOCALCRAFT_HOST=127.0.0.1
LOCALCRAFT_PORT=8000
LOCALCRAFT_DEBUG=false
# critical / error / warning / info / debug
LOG_LEVEL=info
LOCALCRAFT_VERSION=1.0.0
# 对外根地址，用于生成下载链接与 OpenAPI 的 server
LOCALCRAFT_PUBLIC_BASE_URL=http://127.0.0.1:8000

# ---------- 数据库 ----------
# 开发机默认落在 backend/var/localcraft.db（不设 DATABASE_URL 时）。
# SQLite **异步**驱动的绝对路径需要**四个斜杠**：
#   sqlite+aiosqlite:////var/lib/localcraft/localcraft.db
#   前两个是协议分隔符，后两个加路径构成绝对路径。
# 写成三个斜杠会被当成相对路径，数据库文件会落到当前工作目录 —— 这是最常见的配置错误。
# DATABASE_URL=sqlite+aiosqlite:///./var/localcraft.db
# 切 PostgreSQL（D21）：
# DATABASE_URL=postgresql+psycopg://localcraft:password@db.internal:5432/localcraft
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# SQLite 写锁等待毫秒数（契约 §11 硬约束第 3 条要求 busy_timeout=5000）
DB_BUSY_TIMEOUT=5000

# ---------- 数据目录 ----------
# 上传文件、图片、备份的根目录。未设置时默认 backend/var
# DATA_DIR=./var

# ---------- 安全 / 会话 ----------
# 必须用 `openssl rand -hex 32` 生成，不要手写、不要复用测试密钥
SECRET_KEY=change-me-openssl-rand-hex-32
JWT_ALGORITHM=HS256
# access token 有效期（分钟）
ACCESS_TOKEN_MINUTES=30
# refresh token 有效期（天）。契约 §3.2 的 Cookie Max-Age=604800 即 7 天
REFRESH_TOKEN_DAYS=7
# dev 走 Vite proxy、浏览器视角同源（http），因此不需要 Secure。
# **生产（HTTPS）必须改为 true**。
COOKIE_SECURE=false
# 多域名共享 Cookie 时才需要
# COOKIE_DOMAIN=
# 连续登录失败锁定阈值与锁定时长（FR-AUTH-06）
LOGIN_MAX_FAILURES=5
LOCKOUT_MINUTES=15

# ---------- 接口文档 ----------
# 生产默认关闭（SRS FR-API-07）。排障时可临时置 true。
# 注意 export-openapi 命令不依赖这个开关，任何时候都能导出 openapi.json。
API_DOCS_ENABLED=true
