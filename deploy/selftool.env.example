# ============================================================
# selftool 生产环境变量（安装到 /etc/selftool/selftool.env）
# 权限要求: 0640 root:selftool
# 修改后:   systemctl restart selftool
# ------------------------------------------------------------
# ⚠ 语法限制（docs/05 §6.2）：systemd 的 EnvironmentFile 只支持简单的
#   KEY=VALUE，**不支持 export、不支持 $(...)、不支持变量引用**。
#   含空格的值要写成 KEY="a b"。
# ⚠ ExecStart 里用到了 ${SELTOOL_HOST} / ${SELTOOL_PORT} / ${SELTOOL_LOG_LEVEL}，
#   systemd 会对这些做展开。**变量未定义会让 unit 直接启动失败**
#   （Referenced but unset environment variable），所以这三项必须保留。
# ============================================================

# ---------- 基础运行参数 ----------
# 仅监听回环，外部流量一律经 nginx 进入
SELTOOL_HOST=127.0.0.1
SELTOOL_PORT=8000
SELTOOL_DEBUG=false
# critical / error / warning / info / debug
SELTOOL_LOG_LEVEL=info
SELTOOL_PUBLIC_BASE_URL=https://selftool.intra.example.com
SELTOOL_VERSION=1.0.0

# ---------- 数据库 ----------
# 绝对路径需要**四个斜杠**（见 backend/.env.example 的说明）
DATABASE_URL=sqlite+aiosqlite:////var/lib/selftool/selftool.db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# SQLite 写锁等待毫秒数
DB_BUSY_TIMEOUT=5000

# ---------- 数据目录 ----------
DATA_DIR=/var/lib/selftool

# ---------- 安全 / 会话 ----------
# 必须用 `openssl rand -hex 32` 生成：
#     SECRET="$(openssl rand -hex 32)"
#     sed -i "s|^SECRET_KEY=.*|SECRET_KEY=${SECRET}|" /etc/selftool/selftool.env
SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# 生产走 HTTPS，**必须** true，否则 refresh Cookie 会在明文连接上传输
COOKIE_SECURE=true
LOGIN_MAX_FAILURES=5
LOCKOUT_MINUTES=15

# ---------- 接口文档 ----------
# 生产关闭；排障时临时置 true 再 systemctl restart
API_DOCS_ENABLED=false
