# ============================================================
# localcraft 运行目录创建规则（systemd-tmpfiles）
#
# 用途：用声明式规则创建/修正运行时目录与属主权限，替代安装脚本里的一串
#       `install -d`。好处是：机器重启、目录被误删、权限被改动后，
#       执行 `systemd-tmpfiles --create` 即可一键恢复到声明状态。
# 依据：docs/05《部署与运维方案》§4.1（deploy/localcraft.tmpfiles）、§5.2
#       §12.6（权限问题的排查与修正）
#
# 安装位置：/usr/lib/tmpfiles.d/localcraft.conf
# 权限：0644 root:root
# 发布包内路径：deploy/localcraft.tmpfiles
# 立即应用：systemd-tmpfiles --create /usr/lib/tmpfiles.d/localcraft.conf
# 校验：systemd-tmpfiles --cat-config | grep -A2 localcraft
#
# 权限值刻意与 scripts/install.sh 的 `install -d -m 0750 -o localcraft -g localcraft`
# 保持**逐字一致**；两处不一致会导致"安装时正常、tmpfiles 修正后又坏掉"。
#
# 字段格式：类型 路径 权限 属主 属组 年龄 参数
#   d = 目录不存在则创建；已存在时按声明修正属主与权限（不动内容）
#   z = 已存在的文件/目录，只修正属主与权限（不存在则跳过）
# 这里统一用 d：即使目录已存在，也要把权限拉回声明值。
# ============================================================

# ---------- 数据根目录 ----------
# 0750 localcraft:localcraft —— 组外用户连列目录都不行（数据目录里有工具包原件）
d /var/lib/localcraft                    0750 localcraft localcraft -
# 上传/解压落盘区（docs/05 §9.2.5 的临时空间也在这棵树下）
d /var/lib/localcraft/files              0750 localcraft localcraft -
d /var/lib/localcraft/files/uploads      0750 localcraft localcraft -
d /var/lib/localcraft/files/images       0750 localcraft localcraft -
# 备份产物目录（backup.sh 会在其下再建 db/ 与 files/）
d /var/lib/localcraft/backups            0750 localcraft localcraft -
d /var/lib/localcraft/backups/db         0750 localcraft localcraft -
d /var/lib/localcraft/backups/files      0750 localcraft localcraft -

# ---------- 日志目录 ----------
# 应用默认走 journald，这里保留给 LOCALCRAFT_LOG_TO_FILE=true 的可选文件日志，
# 以及演练模式（LOCALCRAFT_SKIP_SYSTEMD=1）下 nohup 重定向的 stdout。
d /var/log/localcraft                    0750 localcraft localcraft -

# ---------- 配置目录 ----------
# 0750 root:localcraft —— 服务只读，root 可写；用 root:localcraft 而不是 localcraft:localcraft，
# 是为了让"改配置"这件事必须经过 root，减少服务被篡改后自我提权的面。
d /etc/localcraft                        0750 root     localcraft     -

# ---------- 代码与运行目录 ----------
# /opt/localcraft 及子目录由 root 拥有、0755 只读（docs/05 §13.2 第 3 条：
# 脚本目录不能被 localcraft 用户写，否则被篡改后会被 systemd 以更高权限执行）。
# 注意：这里**不声明** /opt/localcraft/app/current —— 它是安装/升级脚本维护的
# 软链，用 tmpfiles 的 d 类型去"修正"一个软链会得到意外结果（软链缺失时
# 会被建成真目录，升级脚本随后的 ln -sfn 反而要跟它纠缠）。
d /opt/localcraft                        0755 root     root         -
d /opt/localcraft/app                    0755 root     root         -
d /opt/localcraft/releases               0755 root     root         -
d /opt/localcraft/scripts                0755 root     root         -
