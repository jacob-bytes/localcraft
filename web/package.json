{
  "name": "selftool-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings src",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check:primitives": "node scripts/check-ui-primitives.mjs",
    "check:dist": "node scripts/check-dist-clean.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:primitives && npm run check:api-types && npm run build && npm run check:dist",
    "e2e": "playwright test",
    "e2e:real": "playwright test --config playwright.real.config.ts",
    "evidence": "node scripts/collect-evidence.mjs",
    "backend:isolated": "bash scripts/start-isolated-backend.sh",
    "check:api-types": "node scripts/check-api-types.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.62.11",
    "@tanstack/react-table": "^8.20.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.3",
    "lucide-react": "^0.469.0",
    "markdown-it": "^14.1.0",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^6.28.1",
    "shiki": "^1.24.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "msw": "^2.7.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.2.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
